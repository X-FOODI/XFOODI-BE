generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────────
enum AccountStatus {
  ACTIVE
  DISABLED
}

model Restaurant {
  id               String         @id @default(uuid())
  name             String
  slug             String         @unique
  ownerId          String
  planType         String         @default("FREE")
  logoUrl          String?
  description      String?
  address          String?
  phone            String?
  email            String?
  primaryColor     String?        @default("#FF380B")
  isActive         Boolean        @default(true)
  status           AccountStatus  @default(ACTIVE)
  disabledAt       DateTime?
  disabledBy       String?
  disabledReason   String?        @db.VarChar(500)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  metadata         Json?
  latitude         Float?
  longitude        Float?
  cuisineType      String?        @default("other") // e.g. "vietnamese", "japanese", "fastfood", "other"
  loyaltyPointRate Int            @default(10000)

  owner                User                 @relation("RestaurantOwner", fields: [ownerId], references: [id])
  userRoles            UserRole[]
  aiChatSessions       AIChatSession[]
  categories           Category[]
  dishes               Dish[]
  employees            Employee[]
  floors               Floor[]
  ingredientCategories IngredientCategory[]
  ingredients          Ingredient[]
  mealCombos           MealCombo[]
  notifications        Notification[]
  orders               Order[]
  promotions           Promotion[]
  reservations         Reservation[]
  buckets              RestaurantBucket[]
  documents            RestaurantDocument[]
  wallet               RestaurantWallet?
  owner                User                 @relation("RestaurantOwner", fields: [ownerId], references: [id])
  suppliers            Supplier[]
  tables               Table[]
  userLoyaltyPoints    UserLoyaltyPoint[]
  userRoles            UserRole[]
  vouchers             Voucher[]

  @@map("Restaurants")
}

model Role {
  id        String     @id @default(uuid())
  name      String     @unique
  userRoles UserRole[]

  @@map("Roles")
}

model User {
  id                          String                  @id @default(uuid())
  userName                    String?                 @unique
  email                       String?                 @unique
  passwordHash                String?
  phoneNumber                 String?
  avatarUrl                   String?
  fullName                    String?
  /// "local" | "google" — how the account was created / primary auth
  provider                    String                  @default("local")
  emailVerified               Boolean                 @default(false)
  isActive                    Boolean                 @default(true)
  lastLoginAt                 DateTime?
  resetOtp                    String?
  resetOtpExpires             DateTime?
  /// "MALE" | "FEMALE" | "OTHER"
  gender                      String?
  dateOfBirth                 DateTime?
  address                     String?                 @db.VarChar(255)
  twoFactorEnabled            Boolean                 @default(false)
  twoFactorSecret             String?
  twoFactorBackupCodes        String[]                @default([])
  updatedAt                   DateTime                @updatedAt
  createdAt                   DateTime                @default(now())
  /// Social community extensions (additive)
  bio                         String?                 @db.VarChar(500)
  coverImageUrl               String?
  disabledAt                  DateTime?
  disabledBy                  String?
  disabledReason              String?                 @db.VarChar(500)
  status                      AccountStatus           @default(ACTIVE)
  customer                    Customer?
  employee                    Employee?
  reviewedApplications        RestaurantApplication[] @relation("ApplicationReviewer")
  restaurantApplications      RestaurantApplication[]
  ownedRestaurants            Restaurant[]            @relation("RestaurantOwner")
  savedPosts                  SavedPost[]
  socialComments              SocialComment[]
  socialFollowers             SocialFollow[]          @relation("UserSocialFollowers")
  socialFollowing             SocialFollow[]          @relation("UserSocialFollowing")
  socialNotificationsSent     SocialNotification[]    @relation("NotificationActor")
  socialNotificationsReceived SocialNotification[]    @relation("NotificationRecipient")
  socialPosts                 SocialPost[]
  socialReactions             SocialReaction[]
  socialShares                SocialShare[]
  userLoyaltyPoints           UserLoyaltyPoint[]
  roles                       UserRole[]
  sessions                    UserSession[]
  userVouchers                UserVoucher[]

  @@map("Users")
}

model UserSession {
  id           String    @id @default(uuid())
  userId       String
  refreshToken String    @unique
  deviceInfo   String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("UserSessions")
}

model UserRole {
  userId       String
  roleId       String
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  role         Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([restaurantId])
  @@map("UserRoles")
}

model Employee {
  id                String             @id @default(uuid())
  code              String
  address           String?
  position          String
  hireDate          DateTime           @db.Date
  terminationDate   DateTime?          @db.Date
  salary            Decimal            @db.Decimal(18, 2)
  salaryType        String
  isActive          Boolean            @default(true)
  createdBy         String?
  modifiedBy        String?
  userId            String?            @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  metadata          Json?
  restaurantId      String
  schedules         EmployeeSchedule[]
  restaurant        Restaurant         @relation(fields: [restaurantId], references: [id])
  user              User?              @relation(fields: [userId], references: [id])
  ordersHandled     Order[]
  paymentsProcessed Payment[]

  @@unique([code, restaurantId])
  @@index([restaurantId])
  @@map("Employees")
}

model Customer {
  id                 String              @id @default(uuid())
  membershipLevel    String?
  loyaltyPoints      Int                 @default(0)
  isActive           Boolean             @default(true)
  createdBy          String?
  modifiedBy         String?
  createdAt          DateTime            @default(now())
  metadata           Json?
  updatedAt          DateTime            @default(now()) @updatedAt
  userId             String?             @unique
  user               User?               @relation(fields: [userId], references: [id])
  feedbacks          Feedback[]
  orders             Order[]
  pointsTransactions PointsTransaction[]
  reservations       Reservation[]

  @@map("Customers")
}

model Floor {
  id           String     @id @default(uuid())
  name         String
  imageUrl     String?
  isActive     Boolean    @default(true)
  createdBy    String?
  modifiedBy   String?
  height       Decimal    @default(0.0) @db.Decimal(8, 2)
  width        Decimal    @default(0.0) @db.Decimal(8, 2)
  createdAt    DateTime   @default(now())
  metadata     Json?
  restaurantId String
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  tables       Table[]

  @@index([restaurantId])
  @@map("Floors")
}

model Table {
  id                 String             @id @default(uuid())
  code               String
  type               String
  seatingCapacity    Int
  shape              String
  positionX          Decimal            @db.Decimal(8, 2)
  positionY          Decimal            @db.Decimal(8, 2)
  width              Decimal            @db.Decimal(6, 2)
  height             Decimal            @db.Decimal(6, 2)
  rotation           Decimal            @db.Decimal(5, 2)
  has3DView          Boolean            @default(false)
  viewDescription    String?
  defaultViewUrl     String?
  isActive           Boolean            @default(true)
  createdBy          String?
  modifiedBy         String?
  qrCodeUrl          String?
  floorId            String             @default("00000000-0000-0000-0000-000000000000")
  cubeBackImageUrl   String?
  cubeBottomImageUrl String?
  cubeFrontImageUrl  String?
  cubeLeftImageUrl   String?
  cubeRightImageUrl  String?
  cubeTopImageUrl    String?
  tableStatusId      String
  createdAt          DateTime           @default(now())
  metadata           Json?
  restaurantId       String
  updatedAt          DateTime           @updatedAt
  reservations       ReservationTable[]
  table3DModels      Table3DModel?
  sessions           TableSession[]
  floor              Floor              @relation(fields: [floorId], references: [id])
  restaurant         Restaurant         @relation(fields: [restaurantId], references: [id])
  tableStatus        StatusValue        @relation("TableStatus", fields: [tableStatusId], references: [id])

  @@unique([code, restaurantId])
  @@index([restaurantId])
  @@map("Tables")
}

model Table3DModel {
  id                String   @id @default(uuid())
  tableId           String   @unique
  modelUrl          String
  modelFormat       String?
  environmentMapUrl String?
  backgroundColor   String?
  cameraX           Decimal  @db.Decimal(8, 4)
  cameraY           Decimal  @db.Decimal(8, 4)
  cameraZ           Decimal  @db.Decimal(8, 4)
  cameraFOV         Decimal  @db.Decimal(5, 2)
  allowRotation     Boolean
  allowZoom         Boolean
  minZoom           Decimal  @db.Decimal(4, 2)
  maxZoom           Decimal  @db.Decimal(4, 2)
  createdBy         String?
  modifiedBy        String?
  createdAt         DateTime @default(now())
  metadata          Json?
  updatedAt         DateTime @updatedAt
  table             Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@map("Table3DModels")
}

model Category {
  id           String                    @id @default(uuid())
  name         String
  description  String
  imageUrl     String?
  parentId     String?
  isActive     Boolean                   @default(true)
  createdBy    String?
  modifiedBy   String?
  displayOrder Int                       @default(0)
  createdAt    DateTime                  @default(now())
  metadata     Json?
  restaurantId String?
  updatedAt    DateTime                  @default(now()) @updatedAt
  parent       Category?                 @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children     Category[]                @relation("CategoryHierarchy")
  restaurant   Restaurant?               @relation(fields: [restaurantId], references: [id])
  dishes       Dish[]
  promotions   PromotionApplicableItem[]

  @@index([restaurantId])
  @@map("Categories")
}

model Dish {
  id                 String                    @id @default(uuid())
  categoryId         String
  name               String
  description        String
  price              Decimal                   @db.Decimal(18, 2)
  unit               String
  isVegetarian       Boolean                   @default(false)
  isSpicy            Boolean                   @default(false)
  isBestSeller       Boolean                   @default(false)
  isActive           Boolean                   @default(true)
  autoDisableByStock Boolean                   @default(false)
  createdBy          String?
  modifiedBy         String?
  createdAt          DateTime                  @default(now())
  imageUrl           String?
  metadata           Json?
  restaurantId       String?
  updatedAt          DateTime                  @default(now()) @updatedAt
  comboDetails       ComboDetail[]
  images             DishImage[]
  recipes            DishRecipe[]
  category           Category                  @relation(fields: [categoryId], references: [id])
  restaurant         Restaurant?               @relation(fields: [restaurantId], references: [id])
  orderDetails       OrderDetail[]
  promotions         PromotionApplicableItem[]

  @@index([restaurantId])
  @@index([categoryId])
  @@index([isActive])
  @@index([isBestSeller])
  @@map("Dishes")
}

model DishImage {
  id           String   @id @default(uuid())
  dishId       String
  imageUrl     String
  displayOrder Int
  isActive     Boolean
  createdBy    String?
  modifiedBy   String?
  imageType    Int      @default(0)
  createdAt    DateTime @default(now())
  metadata     Json?
  updatedAt    DateTime @updatedAt
  dish         Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@index([dishId])
  @@map("DishImages")
}

model IngredientCategory {
  id           String       @id @default(uuid())
  name         String
  code         String
  description  String?
  isActive     Boolean
  createdBy    String?
  modifiedBy   String?
  createdAt    DateTime     @default(now())
  metadata     Json?
  restaurantId String
  updatedAt    DateTime     @updatedAt
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])
  ingredients  Ingredient[]

  @@unique([code, restaurantId])
  @@index([restaurantId])
  @@map("IngredientCategories")
}

model Supplier {
  id           String       @id @default(uuid())
  name         String
  phone        String?
  email        String?
  address      String?
  isActive     Boolean
  createdBy    String?
  modifiedBy   String?
  createdAt    DateTime     @default(now())
  metadata     Json?
  restaurantId String
  updatedAt    DateTime     @updatedAt
  ingredients  Ingredient[]
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
  @@map("Suppliers")
}

model Ingredient {
  id                   String              @id @default(uuid())
  name                 String
  code                 String
  unit                 String
  minStockLevel        Decimal             @db.Decimal(10, 3)
  maxStockLevel        Decimal             @db.Decimal(10, 3)
  supplierId           String?
  type                 String?
  isActive             Boolean
  createdBy            String?
  modifiedBy           String?
  ingredientCategoryId String?
  status               Int                 @default(0)
  createdAt            DateTime            @default(now())
  metadata             Json?
  restaurantId         String
  updatedAt            DateTime            @updatedAt
  dishRecipes          DishRecipe[]
  category             IngredientCategory? @relation(fields: [ingredientCategoryId], references: [id])
  restaurant           Restaurant          @relation(fields: [restaurantId], references: [id])
  supplier             Supplier?           @relation(fields: [supplierId], references: [id])
  inventoryStock       InventoryStock?
  stockTransactions    StockTransaction[]

  @@unique([code, restaurantId])
  @@index([restaurantId])
  @@map("Ingredients")
}

model InventoryStock {
  id              String     @id @default(uuid())
  ingredientId    String     @unique
  currentQuantity Decimal    @db.Decimal(10, 3)
  lastRestockDate DateTime?
  lastUpdated     DateTime
  createdBy       String?
  modifiedBy      String?
  createdAt       DateTime   @default(now())
  metadata        Json?
  updatedAt       DateTime   @updatedAt
  ingredient      Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@map("InventoryStocks")
}

model StockTransaction {
  id              String     @id @default(uuid())
  ingredientId    String
  transactionType String?
  quantity        Decimal    @db.Decimal(10, 3)
  unitPrice       Decimal    @db.Decimal(18, 2)
  totalAmount     Decimal    @db.Decimal(18, 2)
  reference       String?
  createdBy       String?
  modifiedBy      String?
  createdAt       DateTime   @default(now())
  metadata        Json?
  updatedAt       DateTime   @updatedAt
  ingredient      Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([ingredientId])
  @@index([createdAt])
  @@map("StockTransactions")
}

model DishRecipe {
  id           String     @id @default(uuid())
  dishId       String
  ingredientId String
  quantity     Decimal    @db.Decimal(10, 3)
  createdBy    String?
  modifiedBy   String?
  createdAt    DateTime   @default(now())
  metadata     Json?
  updatedAt    DateTime   @updatedAt
  dish         Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([dishId])
  @@index([ingredientId])
  @@map("DishRecipes")
}

model MealCombo {
  id           String                    @id @default(uuid())
  name         String
  code         String
  description  String
  imageUrl     String?
  baseCost     Decimal                   @db.Decimal(18, 2)
  price        Decimal                   @db.Decimal(18, 2)
  isActive     Boolean
  createdBy    String?
  modifiedBy   String?
  createdAt    DateTime                  @default(now())
  metadata     Json?
  restaurantId String
  updatedAt    DateTime                  @updatedAt
  comboDetails ComboDetail[]
  restaurant   Restaurant                @relation(fields: [restaurantId], references: [id])
  orderDetails OrderDetail[]
  promotions   PromotionApplicableItem[]

  @@unique([code, restaurantId])
  @@index([restaurantId])
  @@map("MealCombos")
}

model ComboDetail {
  id         String    @id @default(uuid())
  comboId    String
  dishId     String
  quantity   Int
  createdBy  String?
  modifiedBy String?
  createdAt  DateTime  @default(now())
  metadata   Json?
  updatedAt  DateTime  @updatedAt
  combo      MealCombo @relation(fields: [comboId], references: [id], onDelete: Cascade)
  dish       Dish      @relation(fields: [dishId], references: [id])

  @@index([comboId])
  @@index([dishId])
  @@map("ComboDetails")
}

model LoyaltyPointBand {
  id                 String   @id @default(uuid())
  name               String
  min                Int
  max                Int?
  discountPercentage Decimal  @db.Decimal(5, 2)
  benefitDescription String
  isActive           Boolean
  createdBy          String?
  modifiedBy         String?
  logoColor          String?
  createdAt          DateTime @default(now())
  metadata           Json?
  updatedAt          DateTime @updatedAt

  @@map("LoyaltyPointBands")
}

model Notification {
  id               String      @id @default(uuid())
  recipientId      String?
  notificationType String?
  isBroadcast      Boolean
  title            String
  message          String
  imageUrl         String?
  priority         String?
  isPublished      Boolean
  expiryDate       DateTime?
  createdBy        String?
  modifiedBy       String?
  createdAt        DateTime    @default(now())
  metadata         Json?
  restaurantId     String?
  updatedAt        DateTime    @updatedAt
  restaurant       Restaurant? @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
  @@index([recipientId])
  @@index([isPublished])
  @@index([createdAt])
  @@map("Notifications")
}

model Promotion {
  id                String                    @id @default(uuid())
  code              String
  name              String
  discountValue     Decimal                   @db.Decimal(18, 2)
  discountType      String                    @default("PERCENTAGE")
  maxDiscountAmount Decimal                   @db.Decimal(18, 2)
  minOrderAmount    Decimal                   @db.Decimal(18, 2)
  usageLimit        Int
  usagePerCustomer  Int
  validFrom         DateTime
  validTo           DateTime
  isActive          Boolean
  createdBy         String?
  modifiedBy        String?
  createdAt         DateTime                  @default(now())
  metadata          Json?
  restaurantId      String
  updatedAt         DateTime                  @updatedAt
  applicableItems   PromotionApplicableItem[]
  histories         PromotionHistory[]
  restaurant        Restaurant                @relation(fields: [restaurantId], references: [id])

  @@unique([code, restaurantId])
  @@index([restaurantId])
  @@map("Promotions")
}

model PromotionApplicableItem {
  id          String     @id @default(uuid())
  promotionId String
  dishId      String?
  categoryId  String?
  comboId     String?
  createdBy   String?
  modifiedBy  String?
  createdAt   DateTime   @default(now())
  metadata    Json?
  updatedAt   DateTime   @updatedAt
  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  combo       MealCombo? @relation(fields: [comboId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dish        Dish?      @relation(fields: [dishId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  promotion   Promotion  @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@map("PromotionApplicableItems")
}

model StatusType {
  code         String        @unique
  createdBy    String?
  modifiedBy   String?
  id           String        @id @default(uuid())
  createdAt    DateTime      @default(now())
  metadata     Json?
  updatedAt    DateTime      @updatedAt
  statusValues StatusValue[]

  @@map("StatusTypes")
}

model StatusValue {
  code              String
  name              String
  colorCode         String?
  isDefault         Boolean            @default(false)
  createdBy         String?
  modifiedBy        String?
  displayOrder      Int                @default(1)
  isSystem          Boolean            @default(true)
  id                String             @id @default(uuid())
  statusTypeId      String
  createdAt         DateTime           @default(now())
  metadata          Json?
  updatedAt         DateTime           @updatedAt
  employeeSchedules EmployeeSchedule[] @relation("ScheduleStatus")
  orderDetails      OrderDetail[]      @relation("OrderDetailStatus")
  reservations      Reservation[]      @relation("ReservationStatus")
  statusType        StatusType         @relation(fields: [statusTypeId], references: [id])
  tables            Table[]            @relation("TableStatus")

  @@map("StatusValues")
}

model EmployeeSchedule {
  id           String      @id @default(uuid())
  employeeId   String
  workDate     DateTime    @db.Date
  startTime    DateTime    @db.Time(6)
  endTime      DateTime    @db.Time(6)
  checkInTime  DateTime?
  checkOutTime DateTime?
  createdBy    String?
  modifiedBy   String?
  statusId     String
  createdAt    DateTime    @default(now())
  metadata     Json?
  updatedAt    DateTime    @updatedAt
  employee     Employee    @relation(fields: [employeeId], references: [id])
  statusValue  StatusValue @relation("ScheduleStatus", fields: [statusId], references: [id])

  @@index([employeeId])
  @@index([workDate])
  @@index([statusId])
  @@map("EmployeeSchedules")
}

model ReservationTable {
  id            String      @id @default(uuid())
  reservationId String
  tableId       String
  assignedAt    DateTime    @default(now())
  assignedBy    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  table         Table       @relation(fields: [tableId], references: [id])

  @@unique([reservationId, tableId])
  @@map("ReservationTables")
}

model Reservation {
  id                  String             @id @default(uuid())
  customerId          String
  numberOfGuests      Int
  time                DateTime
  specialRequests     String?
  depositAmount       Decimal            @db.Decimal(18, 2)
  checkedInAt         DateTime?
  createdBy           String?
  modifiedBy          String?
  confirmationCode    String?            @unique
  paymentDeadline     DateTime?
  reservationStatusId String
  createdAt           DateTime           @default(now())
  metadata            Json?
  restaurantId        String
  updatedAt           DateTime           @updatedAt
  completedAt         DateTime?
  reminderSentAt      DateTime?
  orders              Order[]
  payments            Payment[]
  refunds             Refund[]
  tables              ReservationTable[]
  customer            Customer           @relation(fields: [customerId], references: [id])
  statusValue         StatusValue        @relation("ReservationStatus", fields: [reservationStatusId], references: [id])
  restaurant          Restaurant         @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
  @@index([customerId])
  @@index([reservationStatusId])
  @@index([time])
  @@map("Reservations")
}

model Refund {
  id            String      @id @default(uuid())
  reservationId String
  amount        Decimal     @db.Decimal(18, 2)
  status        String      @default("PENDING")
  metadata      Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  payments      Payment[]
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([reservationId])
  @@map("Refunds")
}

model Order {
  id                 String              @id @default(uuid())
  reference          String              @unique
  customerId         String?
  reservationId      String?
  subTotal           Decimal             @db.Decimal(18, 2)
  discountAmount     Decimal             @db.Decimal(18, 2)
  taxAmount          Decimal             @db.Decimal(18, 2)
  serviceCharge      Decimal             @db.Decimal(18, 2)
  totalAmount        Decimal             @db.Decimal(18, 2)
  completedAt        DateTime?
  cancelledAt        DateTime?
  handledBy          String?
  createdBy          String?
  modifiedBy         String?
  orderStatusId      String
  createdAt          DateTime            @default(now())
  metadata           Json?
  restaurantId       String?
  updatedAt          DateTime            @default(now()) @updatedAt
  feedbacks          Feedback[]
  orderDetails       OrderDetail[]
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee           Employee?           @relation(fields: [handledBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reservation        Reservation?        @relation(fields: [reservationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  restaurant         Restaurant?         @relation(fields: [restaurantId], references: [id])
  payments           Payment[]
  pointsTransactions PointsTransaction[]
  promotionHistories PromotionHistory[]
  tableSessions      TableSession[]

  @@index([restaurantId])
  @@index([customerId])
  @@index([reservationId])
  @@index([orderStatusId])
  @@index([createdAt])
  @@index([handledBy])
  @@map("Orders")
}

model OrderDetail {
  id           String        @id @default(uuid())
  orderId      String
  dishId       String?
  quantity     Int
  note         String?
  createdBy    String?
  modifiedBy   String?
  unitPrice    Decimal       @default(0.0) @db.Decimal(18, 2)
  comboId      String?
  parentId     String?
  comboName    String?
  comboPrice   Decimal?      @db.Decimal(18, 2)
  itemStatusId String
  createdAt    DateTime      @default(now())
  metadata     Json?
  updatedAt    DateTime      @updatedAt
  combo        MealCombo?    @relation(fields: [comboId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dish         Dish?         @relation(fields: [dishId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  statusValue  StatusValue   @relation("OrderDetailStatus", fields: [itemStatusId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  parent       OrderDetail?  @relation("OrderDetailHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children     OrderDetail[] @relation("OrderDetailHierarchy")

  @@index([orderId])
  @@index([dishId])
  @@index([comboId])
  @@index([itemStatusId])
  @@map("OrderDetails")
}

model PaymentMethod {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  payments  Payment[]

  @@map("PaymentMethods")
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String?
  reservationId   String?
  paymentMethodId String
  transactionId   String?
  amount          Decimal       @db.Decimal(18, 2)
  cashReceive     Decimal       @db.Decimal(18, 2)
  paymentDate     DateTime      @default(now())
  cashback        Decimal       @db.Decimal(18, 2)
  refundDate      DateTime?
  processedBy     String?
  createdBy       String?
  modifiedBy      String?
  checkoutUrl     String?
  payOSOrderCode  BigInt?       @unique
  status          Int           @default(0)
  purpose         Int           @default(0)
  createdAt       DateTime      @default(now())
  metadata        Json?
  updatedAt       DateTime      @updatedAt
  refundId        String?
  order           Order?        @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  employee        Employee?     @relation(fields: [processedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  refund          Refund?       @relation(fields: [refundId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reservation        Reservation?         @relation(fields: [reservationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vatInvoiceRequests VatInvoiceRequest[]

  @@index([orderId])
  @@index([reservationId])
  @@index([status])
  @@index([paymentDate])
  @@index([refundId])
  @@map("Payments")
}

model PointsTransaction {
  id          String   @id @default(uuid())
  customerId  String
  type        String
  points      Int
  orderId     String?
  description String?
  createdBy   String?
  modifiedBy  String?
  sourceType  String?
  createdAt   DateTime @default(now())
  metadata    Json?
  updatedAt   DateTime @updatedAt
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([customerId])
  @@index([orderId])
  @@map("PointsTransactions")
}

model PromotionHistory {
  id             String    @id @default(uuid())
  promotionId    String
  orderId        String
  discountAmount Decimal   @db.Decimal(18, 2)
  createdBy      String?
  modifiedBy     String?
  createdAt      DateTime  @default(now())
  metadata       Json?
  updatedAt      DateTime  @updatedAt
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promotion      Promotion @relation(fields: [promotionId], references: [id])

  @@index([promotionId])
  @@index([orderId])
  @@map("PromotionHistories")
}

model TableSession {
  id         String    @id @default(uuid())
  tableId    String
  orderId    String?
  startedAt  DateTime
  endedAt    DateTime?
  isActive   Boolean
  createdBy  String?
  modifiedBy String?
  createdAt  DateTime  @default(now())
  metadata   Json?
  updatedAt  DateTime  @updatedAt
  order      Order?    @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  table      Table     @relation(fields: [tableId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tableId])
  @@index([isActive])
  @@index([startedAt])
  @@map("TableSessions")
}

model Feedback {
  id          String          @id @default(uuid())
  orderId     String
  customerId  String
  rating      Int
  comment     String?
  isPublished Boolean
  isAnonymous Boolean
  createdBy   String?
  modifiedBy  String?
  createdAt   DateTime        @default(now())
  metadata    Json?
  updatedAt   DateTime        @updatedAt
  images      FeedbackImage[]
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order       Order           @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([orderId, customerId])
  @@map("Feedbacks")
}

model FeedbackImage {
  id           String   @id @default(uuid())
  feedbackId   String
  imageUrl     String
  displayOrder Int
  isCover      Boolean
  createdBy    String?
  modifiedBy   String?
  createdAt    DateTime @default(now())
  metadata     Json?
  updatedAt    DateTime @updatedAt
  feedback     Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@map("FeedbackImages")
}

model AIChatSession {
  id           String          @id @default(uuid())
  sessionId    String          @unique
  customerId   String?
  tableId      String?
  expiresAt    DateTime
  createdBy    String?
  modifiedBy   String?
  createdAt    DateTime        @default(now())
  metadata     Json?
  restaurantId String?
  updatedAt    DateTime        @default(now()) @updatedAt
  messages     AIChatMessage[]
  restaurant   Restaurant?     @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
  @@map("AIChatSessions")
}

model AIChatMessage {
  id              String        @id @default(uuid())
  aiChatSessionId String
  role            String
  content         String
  createdBy       String?
  modifiedBy      String?
  createdAt       DateTime      @default(now())
  metadata        Json?
  updatedAt       DateTime      @default(now()) @updatedAt
  session         AIChatSession @relation(fields: [aiChatSessionId], references: [id], onDelete: Cascade)

  @@map("AIChatMessages")
}

model SocialPost {
  id           String              @id @default(uuid())
  authorId     String
  content      String
  /// public | followers | private
  visibility   String              @default("public")
  repostOfId   String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  savedBy      SavedPost[]
  comments     SocialComment[]
  images       SocialImage[]
  postHashtags SocialPostHashtag[]
  author       User                @relation(fields: [authorId], references: [id])
  repostOf     SocialPost?         @relation("PostReposts", fields: [repostOfId], references: [id])
  reposts      SocialPost[]        @relation("PostReposts")
  reactions    SocialReaction[]
  shares       SocialShare[]

  @@index([authorId])
  @@index([createdAt])
  @@index([visibility])
  @@index([repostOfId])
  @@map("SocialPosts")
}

model SocialImage {
  id       String     @id @default(uuid())
  postId   String
  imageUrl String
  post     SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("SocialImages")
}

model SocialComment {
  id        String          @id @default(uuid())
  postId    String
  userId    String
  parentId  String?
  content   String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  parent    SocialComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   SocialComment[] @relation("CommentReplies")
  post      SocialPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id])

  @@index([postId])
  @@index([userId])
  @@index([parentId])
  @@map("SocialComments")
}

model SocialReaction {
  id        String     @id @default(uuid())
  postId    String
  userId    String
  type      String
  createdAt DateTime   @default(now())
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@index([postId])
  @@map("SocialReactions")
}

model SocialShare {
  id        String     @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime   @default(now())
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id])

  @@index([postId])
  @@index([userId])
  @@map("SocialShares")
}

model SavedPost {
  id        String     @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime   @default(now())
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@index([userId])
  @@map("SavedPosts")
}

/// Alias concept: SocialPostImage — persisted as SocialImage (legacy table)
model SocialFollow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserSocialFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserSocialFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("SocialFollows")
}

model SocialHashtag {
  id        String              @id @default(uuid())
  tag       String              @unique
  postCount Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  posts     SocialPostHashtag[]

  @@index([postCount])
  @@map("SocialHashtags")
}

model SocialPostHashtag {
  postId    String
  hashtagId String
  createdAt DateTime      @default(now())
  hashtag   SocialHashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)
  post      SocialPost    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, hashtagId])
  @@index([hashtagId])
  @@map("SocialPostHashtags")
}

/// Alias concept: SocialBookmark — persisted as SavedPost (legacy table)
model SocialNotification {
  id        String   @id @default(uuid())
  userId    String
  actorId   String
  type      String
  postId    String?
  commentId String?
  message   String?  @db.VarChar(500)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  actor     User     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  recipient User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([actorId])
  @@map("SocialNotifications")
}

model RestaurantApplication {
  id                 String    @id @default(uuid())
  restaurantName     String
  email              String
  phone              String
  description        String?
  status             String    @default("PENDING")
  reviewedBy         String?
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  address            String
  businessLicenseEnc String?
  cuisineType        String?   @default("other")
  latitude           Float?
  logoUrl            String?
  longitude          Float?
  nationalIdBackEnc  String?
  nationalIdEnc      String?
  ownershipProofEnc  String?
  reviewNote         String?
  slug               String
  userId             String
  reviewer           User?     @relation("ApplicationReviewer", fields: [reviewedBy], references: [id])
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("RestaurantApplications")
}

model RestaurantDocument {
  id           String            @id @default(uuid())
  restaurantId String
  bucketId     String?
  filename     String
  fileUrl      String
  fileType     String
  status       String            @default("PENDING")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  versionId    String?
  errorLog     String?
  chunks       DocumentChunk[]
  bucket       RestaurantBucket? @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([bucketId])
  @@map("RestaurantDocuments")
}

model DocumentChunk {
  id         String                @id @default(uuid())
  documentId String
  content    String
  embedding  Unsupported("vector")
  metadata   Json?
  createdAt  DateTime              @default(now())
  document   RestaurantDocument    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("DocumentChunks")
}

model RestaurantBucket {
  id               String               @id @default(uuid())
  restaurantId     String
  name             String
  url              String
  description      String?
  isChatEnabled    Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  isMounted        Boolean              @default(false)
  chunkingStrategy String               @default("FIXED")
  chunkSize        Int                  @default(800)
  chunkOverlap     Int                  @default(100)
  restaurant       Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  documents        RestaurantDocument[]

  @@unique([restaurantId, name])
  @@map("RestaurantBuckets")
}

model RestaurantKBSnapshot {
  id           String   @id @default(uuid())
  restaurantId String
  bucketId     String?
  versionName  String
  description  String?
  createdAt    DateTime @default(now())
  documents    Json

  @@index([restaurantId])
  @@map("RestaurantKBSnapshots")
}

model RestaurantLayout {
  id             String    @id @default(uuid())
  tenantId       String
  tenantHostname String
  name           String
  status         String    @default("draft")
  version        Int       @default(1)
  theme          Json
  sections       Json
  seo            Json
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId])
  @@index([tenantHostname, status])
  @@map("RestaurantLayouts")
}

/// Tracks each restaurant owner's accumulated revenue.
/// Money physically sits in admin's bank account; this is a ledger balance.
model RestaurantWallet {
  id             String              @id @default(uuid())
  restaurantId   String              @unique
  balance        Decimal             @default(0) @db.Decimal(18, 2)
  lifetimeEarned Decimal             @default(0) @db.Decimal(18, 2)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  cashBalance    Decimal             @default(0) @db.Decimal(18, 2)
  restaurant     Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  transactions   WalletTransaction[]
  withdrawals    WithdrawalRequest[]

  @@map("RestaurantWallets")
}

model WalletTransaction {
  id            String           @id @default(uuid())
  walletId      String
  type          String
  amount        Decimal          @db.Decimal(18, 2)
  balanceBefore Decimal          @db.Decimal(18, 2)
  balanceAfter  Decimal          @db.Decimal(18, 2)
  description   String?
  orderId       String?
  paymentId     String?
  metadata      Json?
  createdAt     DateTime         @default(now())
  wallet        RestaurantWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([type])
  @@index([createdAt])
  @@map("WalletTransactions")
}

/// Withdrawal request from restaurant owner.
/// Admin approves → PayOS disburses → balance deducted.
model WithdrawalRequest {
  id              String           @id @default(uuid())
  walletId        String
  restaurantId    String
  amount          Decimal          @db.Decimal(18, 2)
  status          String           @default("PENDING")
  bankCode        String
  bankBin         String
  accountNumber   String
  accountName     String
  adminNote       String?
  rejectionReason String?
  externalTxId    String?
  processedBy     String?
  processedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  wallet          RestaurantWallet @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([restaurantId])
  @@index([status])
  @@map("WithdrawalRequests")
}

model UserLoyaltyPoint {
  id           String     @id @default(uuid())
  userId       String
  restaurantId String
  points       Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([userId])
  @@index([restaurantId])
  @@map("UserLoyaltyPoints")
}

model Voucher {
  id                String        @id @default(uuid())
  restaurantId      String?
  code              String
  title             String
  description       String?
  discountValue     Decimal       @db.Decimal(18, 2)
  discountType      String
  pointsRequired    Int
  expiryDate        DateTime
  quantity          Int
  applicableService String        @default("all")
  distributionMode  String        @default("public")
  status            String        @default("active")
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  userVouchers      UserVoucher[]
  restaurant        Restaurant?   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([code, restaurantId])
  @@index([restaurantId])
  @@map("Vouchers")
}

model UserVoucher {
  id         String    @id @default(uuid())
  userId     String
  voucherId  String
  isUsed     Boolean   @default(false)
  usedAt     DateTime?
  redeemedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  voucher    Voucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([voucherId])
  @@map("UserVouchers")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("SystemSettings")
}

model VatInvoiceRequest {
  id             String   @id @default(uuid())
  paymentId      String
  restaurantId   String
  companyName    String
  taxId          String
  address        String
  email          String
  /// "PENDING" | "COMPLETED" | "FAILED"
  status         String   @default("PENDING")
  misaRefId      String?
  misaLookupCode String?
  errorMessage   String?  @db.VarChar(1000)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([restaurantId])
  @@map("VatInvoiceRequests")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  adminId    String
  actorEmail String?
  actorName  String?
  targetType String?
  targetId   String
  method     String?
  path       String?
  ipAddress  String?
  status     String   @default("SUCCESS")
  reason     String?  @db.VarChar
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([targetId])
  @@index([createdAt])
  @@map("AuditLogs")
}

model Announcement {
  id        String    @id @default(uuid())
  title     String
  content   String    @db.Text
  level     String    @default("INFO")
  isActive  Boolean   @default(true)
  createdBy String?
  actorName String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([isActive])
  @@map("Announcements")
}
