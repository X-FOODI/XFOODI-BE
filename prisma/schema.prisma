generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Tenant Root ───────────────────────────────────────────────────────────────

model Restaurant {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  ownerId      String
  planType     String   @default("FREE")
  logoUrl      String?
  description  String?
  address      String?
  phone        String?
  email        String?
  primaryColor String?  @default("#FF380B")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  metadata     Json?
  latitude     Float?
  longitude    Float?
  cuisineType  String?  @default("other") // e.g. "vietnamese", "japanese", "fastfood", "other"

  owner                User                 @relation("RestaurantOwner", fields: [ownerId], references: [id])
  userRoles            UserRole[]
  employees            Employee[]
  floors               Floor[]
  tables               Table[]
  categories           Category[]
  dishes               Dish[]
  ingredients          Ingredient[]
  ingredientCategories IngredientCategory[]
  suppliers            Supplier[]
  orders               Order[]
  reservations         Reservation[]
  promotions           Promotion[]
  mealCombos           MealCombo[]
  notifications        Notification[]
  aiChatSessions       AIChatSession[]
  documents            RestaurantDocument[]
  buckets              RestaurantBucket[]

  @@map("Restaurants")
}

// ─── Identity & Auth ───────────────────────────────────────────────────────────

model Role {
  id   String @id @default(uuid())
  name String @unique
  userRoles UserRole[]

  @@map("Roles")
}

model User {
  id                                                              String                   @id @default(uuid())
  userName                                                        String?                  @unique
  email                                                           String?                  @unique
  passwordHash                                                    String?
  phoneNumber                                                     String?
  avatarUrl                                                       String?
  fullName                                                        String?
  /// "local" | "google" — how the account was created / primary auth
  provider      String    @default("local")
  /// "MALE" | "FEMALE" | "OTHER"
  gender        String?
  dateOfBirth   DateTime?
  address       String?   @db.VarChar(255)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String[]  @default([])

  employee         Employee?
  customer         Customer?
  roles            UserRole[]
  sessions         UserSession[]
  ownedRestaurants Restaurant[] @relation("RestaurantOwner")
  restaurantApplications RestaurantApplication[]
  reviewedApplications   RestaurantApplication[] @relation("ApplicationReviewer")

  @@map("Users")
}

model UserSession {
  id           String    @id @default(uuid())
  userId       String
  refreshToken String    @unique
  deviceInfo   String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("UserSessions")
}

model UserRole {
  userId       String
  roleId       String
  restaurantId String?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([restaurantId])
  @@map("UserRoles")
}

