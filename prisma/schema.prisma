generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AIChatSession {
  id             String    @id @default(uuid())
  sessionId      String    @unique
  customerId     String?
  tableId        String?
  expiresAt      DateTime
  createdDate    DateTime  @default(now())
  modifiedDate   DateTime? @updatedAt
  createdBy      String?
  modifiedBy     String?
  propertiesJson Json?

  messages AIChatMessage[]

  @@map("AIChatSessions")
}

model AIChatMessage {
  id              String    @id @default(uuid())
  aiChatSessionId String
  role            String
  content         String
  createdDate     DateTime  @default(now())
  modifiedDate    DateTime? @updatedAt
  createdBy       String?
  modifiedBy      String?
  propertiesJson  Json?

  session AIChatSession @relation(fields: [aiChatSessionId], references: [id], onDelete: Cascade)

  @@map("AIChatMessages")
}

model Role {
  id               String  @id @default(uuid())
  name             String?
  normalizedName   String? @unique
  concurrencyStamp String?

  userRoles UserRole[]

  @@map("Roles")
}

model User {
  id            String    @id @default(uuid())
  userName      String?   @unique
  email         String?   @unique
  emailVerified Boolean   @default(false)
  passwordHash  String?
  /// "local" | "google" — how the account was created / primary auth
  provider      String    @default("local")
  phoneNumber   String?
  avatarUrl     String?
  fullName      String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdDate   DateTime  @default(now())
  modifiedDate  DateTime? @updatedAt

  employee Employee?
  customer Customer?

  roles    UserRole[]
  sessions UserSession[]

  @@map("Users")
}

model UserSession {
  id           String    @id @default(uuid())
  userId       String
  refreshToken String    @unique
  deviceInfo   String? // "Chrome on Windows", "iPhone App"
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("UserSessions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("UserRoles")
}

model Employee {
  id              String    @id @default(uuid())
  code            String    @unique
  userId          String?   @unique
  address         String?
  position        String
  hireDate        DateTime  @db.Date
  terminationDate DateTime? @db.Date
  salary          Decimal   @db.Decimal(18, 2)
  salaryType      String
  isActive        Boolean   @default(true)
  createdDate     DateTime  @default(now())
  modifiedDate    DateTime? @updatedAt
  createdBy       String?
  modifiedBy      String?
  propertiesJson  Json?

  user              User?              @relation(fields: [userId], references: [id])
  ordersHandled     Order[]
  paymentsProcessed Payment[]
  schedules         EmployeeSchedule[]

  @@map("Employees")
}

model Customer {
  id                String    @id @default(uuid())
  applicationUserId String    @unique
  membershipLevel   String?
  loyaltyPoints     Int       @default(0)
  isActive          Boolean   @default(true)
  createdDate       DateTime  @default(now())
  modifiedDate      DateTime? @updatedAt
  createdBy         String?
  modifiedBy        String?
  propertiesJson    Json?

  user               User                @relation(fields: [applicationUserId], references: [id])
  orders             Order[]
  reservations       Reservation[]
  pointsTransactions PointsTransaction[]
  feedbacks          Feedback[]

  @@map("Customers")
}

model Floor {
  id             String    @id @default(uuid())
  name           String
  imageUrl       String?
  isActive       Boolean   @default(true)
  createdDate    DateTime  @default(now())
  modifiedDate   DateTime? @updatedAt
  createdBy      String?
  modifiedBy     String?
  height         Decimal   @default(0.0) @db.Decimal(8, 2)
  width          Decimal   @default(0.0) @db.Decimal(8, 2)
  propertiesJson Json?

  tables Table[]

  @@map("Floors")
}

model Table {
  id                 String    @id @default(uuid())
  code               String    @unique
  type               String
  seatingCapacity    Int
  shape              String
  positionX          Decimal   @db.Decimal(8, 2)
  positionY          Decimal   @db.Decimal(8, 2)
  width              Decimal   @db.Decimal(6, 2)
  height             Decimal   @db.Decimal(6, 2)
  rotation           Decimal   @db.Decimal(5, 2)
  has3DView          Boolean   @default(false)
  viewDescription    String?
  defaultViewUrl     String?
  isActive           Boolean   @default(true)
  createdDate        DateTime  @default(now())
  modifiedDate       DateTime? @updatedAt
  createdBy          String?
  modifiedBy         String?
  tableStatusId      Int       @default(0)
  qrCodeUrl          String?
  floorId            String    @default("00000000-0000-0000-0000-000000000000")
  propertiesJson     Json?
  cubeBackImageUrl   String?
  cubeBottomImageUrl String?
  cubeFrontImageUrl  String?
  cubeLeftImageUrl   String?
  cubeRightImageUrl  String?
  cubeTopImageUrl    String?

  floor         Floor              @relation(fields: [floorId], references: [id])
  table3DModels Table3DModel[]
  sessions      TableSession[]
  reservations  ReservationTable[]

  @@map("Tables")
}

model Table3DModel {
  id                String    @id @default(uuid())
  tableId           String    @unique
  modelUrl          String
  modelFormat       String?
  environmentMapUrl String?
  backgroundColor   String?
  cameraX           Decimal   @db.Decimal(8, 4)
  cameraY           Decimal   @db.Decimal(8, 4)
  cameraZ           Decimal   @db.Decimal(8, 4)
  cameraFOV         Decimal   @db.Decimal(5, 2)
  allowRotation     Boolean
  allowZoom         Boolean
  minZoom           Decimal   @db.Decimal(4, 2)
  maxZoom           Decimal   @db.Decimal(4, 2)
  createdDate       DateTime  @default(now())
  modifiedDate      DateTime? @updatedAt
  createdBy         String?
  modifiedBy        String?
  propertiesJson    Json?

  table Table @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@map("Table3DModels")
}

model Category {
  id             String    @id @default(uuid())
  name           String
  description    String
  imageUrl       String?
  parentId       String?
  isActive       Boolean   @default(true)
  createdDate    DateTime  @default(now())
  modifiedDate   DateTime? @updatedAt
  createdBy      String?
  modifiedBy     String?
  propertiesJson Json?
  displayOrder   Int       @default(0)

  parent     Category?                 @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children   Category[]                @relation("CategoryHierarchy")
  dishes     Dish[]
  promotions PromotionApplicableItem[]

  @@map("Categories")
}

model Dish {
  id                 String    @id @default(uuid())
  categoryId         String
  name               String
  description        String
  price              Decimal   @db.Decimal(18, 2)
  unit               String
  isVegetarian       Boolean   @default(false)
  isSpicy            Boolean   @default(false)
  isBestSeller       Boolean   @default(false)
  isActive           Boolean   @default(true)
  autoDisableByStock Boolean   @default(false)
  createdDate        DateTime  @default(now())
  modifiedDate       DateTime? @updatedAt
  createdBy          String?
  modifiedBy         String?
  propertiesJson     Json?

  category     Category                  @relation(fields: [categoryId], references: [id])
  orderDetails OrderDetail[]
  images       DishImage[]
  recipes      DishRecipe[]
  promotions   PromotionApplicableItem[]
  comboDetails ComboDetail[]

  @@index([categoryId])
  @@index([isActive])
  @@index([isBestSeller])
  @@map("Dishes")
}

model DishImage {
  id             String    @id @default(uuid())
  dishId         String
  imageUrl       String
  displayOrder   Int
  isActive       Boolean
  createdDate    DateTime  @default(now())
  modifiedDate   DateTime? @updatedAt
  createdBy      String?
  modifiedBy     String?
  imageType      Int       @default(0)
  propertiesJson Json?

  dish Dish @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@map("DishImages")
}

model IngredientCategory {
  id             String    @id @default(uuid())
  name           String
  code           String    @unique
  description    String?
  isActive       Boolean
  createdDate    DateTime  @default(now())
  modifiedDate   DateTime? @updatedAt
  createdBy      String?
  modifiedBy     String?
  propertiesJson Json?

  ingredients Ingredient[]

  @@map("IngredientCategories")
}

model Supplier {
  id             String    @id @default(uuid())
  name           String
  phone          String?
  email          String?
  address        String?
  isActive       Boolean
  createdDate    DateTime  @default(now())
  modifiedDate   DateTime? @updatedAt
  createdBy      String?
  modifiedBy     String?
  propertiesJson Json?

  ingredients Ingredient[]

  @@map("Suppliers")
}

model Ingredient {
  id                   String    @id @default(uuid())
  name                 String
  code                 String    @unique
  unit                 String
  minStockLevel        Decimal   @db.Decimal(10, 3)
  maxStockLevel        Decimal   @db.Decimal(10, 3)
  supplierId           String?
  type                 String?
  isActive             Boolean
  createdDate          DateTime  @default(now())
  modifiedDate         DateTime? @updatedAt
  createdBy            String?
  modifiedBy           String?
  ingredientCategoryId String?
  status               Int       @default(0)
  propertiesJson       Json?

  category          IngredientCategory? @relation(fields: [ingredientCategoryId], references: [id])
  supplier          Supplier?           @relation(fields: [supplierId], references: [id])
  inventoryStock    InventoryStock?
  stockTransactions StockTransaction[]
  dishRecipes       DishRecipe[]

  @@map("Ingredients")
}

model InventoryStock {
  id              String    @id @default(uuid())
  ingredientId    String    @unique
  currentQuantity Decimal   @db.Decimal(10, 3)
  lastRestockDate DateTime?
  lastUpdated     DateTime
  createdDate     DateTime  @default(now())
  modifiedDate    DateTime? @updatedAt
  createdBy       String?
  modifiedBy      String?
  propertiesJson  Json?

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@map("InventoryStocks")
}

model StockTransaction {
  id              String    @id @default(uuid())
  ingredientId    String
  transactionType String?
  quantity        Decimal   @db.Decimal(10, 3)
  unitPrice       Decimal   @db.Decimal(18, 2)
  totalAmount     Decimal   @db.Decimal(18, 2)
  reference       String?
  createdDate     DateTime  @default(now())
  modifiedDate    DateTime? @updatedAt
  createdBy       String?
  modifiedBy      String?
  propertiesJson  Json?

  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([ingredientId])
  @@index([createdDate])
  @@map("StockTransactions")
}

model DishRecipe {
  id             String    @id @default(uuid())
  dishId         String
  ingredientId   String
  quantity       Decimal   @db.Decimal(10, 3)
  createdDate    DateTime  @default(now())
  modifiedDate   DateTime? @updatedAt
  createdBy      String?
  modifiedBy     String?
  propertiesJson Json?

  dish       Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@map("DishRecipes")
}

model MealCombo {
  id             String    @id @default(uuid())
  name           String
  code           String    @unique
  description    String
  imageUrl       String?
  baseCost       Decimal   @db.Decimal(18, 2)
  price          Decimal   @db.Decimal(18, 2)
  isActive       Boolean
  createdDate    DateTime  @default(now())
  modifiedDate   DateTime? @updatedAt
  createdBy      String?
  modifiedBy     String?
  propertiesJson Json?

  comboDetails ComboDetail[]
  promotions   PromotionApplicableItem[]
  orderDetails OrderDetail[]

  @@map("MealCombos")
}

model ComboDetail {
  id             String    @id @default(uuid())
  comboId        String
  dishId         String
  quantity       Int
  createdDate    DateTime  @default(now())
  modifiedDate   DateTime? @updatedAt
  createdBy      String?
  modifiedBy     String?
  propertiesJson Json?

  combo MealCombo @relation(fields: [comboId], references: [id], onDelete: Cascade)
  dish  Dish      @relation(fields: [dishId], references: [id])

  @@map("ComboDetails")
}

model LoyaltyPointBand {
  id                 String    @id @default(uuid())
  name               String
  min                Int
  max                Int?
  discountPercentage Decimal   @db.Decimal(5, 2)
  benefitDescription String
  isActive           Boolean
  createdDate        DateTime  @default(now())
  modifiedDate       DateTime? @updatedAt
  createdBy          String?
  modifiedBy         String?
  logoColor          String?
  propertiesJson     Json?

  @@map("LoyaltyPointBands")
}

model Notification {
  id               String    @id @default(uuid())
  recipientId      String?
  notificationType String?
  isBroadcast      Boolean
  title            String
  message          String
  imageUrl         String?
  priority         String?
  isPublished      Boolean
  expiryDate       DateTime?
  createdDate      DateTime  @default(now())
  modifiedDate     DateTime? @updatedAt
  createdBy        String?
  modifiedBy       String?
  propertiesJson   Json?

  @@index([recipientId])
  @@index([isPublished])
  @@index([createdDate])
  @@map("Notifications")
}

model Promotion {
  id                String    @id @default(uuid())
  code              String    @unique
  name              String
  discountValue     Decimal   @db.Decimal(18, 2)
  discountType      String    @default("PERCENTAGE")
  maxDiscountAmount Decimal   @db.Decimal(18, 2)
  minOrderAmount    Decimal   @db.Decimal(18, 2)
  usageLimit        Int
  usagePerCustomer  Int
  validFrom         DateTime
  validTo           DateTime
  isActive          Boolean
  createdDate       DateTime  @default(now())
  modifiedDate      DateTime? @updatedAt
  createdBy         String?
  modifiedBy        String?
  propertiesJson    Json?

  applicableItems PromotionApplicableItem[]
  histories       PromotionHistory[]

  @@map("Promotions")
}

model PromotionApplicableItem {
  id             String    @id @default(uuid())
  promotionId    String
  dishId         String?
  categoryId     String?
  comboId        String?
  createdDate    DateTime  @default(now())
  modifiedDate   DateTime? @updatedAt
  createdBy      String?
  modifiedBy     String?
  propertiesJson Json?

  promotion Promotion  @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  dish      Dish?      @relation(fields: [dishId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category  Category?  @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  combo     MealCombo? @relation(fields: [comboId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("PromotionApplicableItems")
}

model StatusType {
  id             Int       @id @default(autoincrement())
  code           String    @unique
  createdDate    DateTime  @default(now())
  modifiedDate   DateTime? @updatedAt
  createdBy      String?
  modifiedBy     String?
  propertiesJson Json?

  statusValues StatusValue[]

  @@map("StatusTypes")
}

model StatusValue {
  id             Int       @id @default(autoincrement())
  statusTypeId   Int
  code           String
  name           String
  colorCode      String?
  isDefault      Boolean   @default(false)
  createdDate    DateTime  @default(now())
  modifiedDate   DateTime? @updatedAt
  createdBy      String?
  modifiedBy     String?
  propertiesJson Json?
  displayOrder   Int       @default(1)
  isSystem       Boolean   @default(true)

  statusType        StatusType         @relation(fields: [statusTypeId], references: [id])
  employeeSchedules EmployeeSchedule[]
  reservations      Reservation[]
  orderDetails      OrderDetail[]

  @@map("StatusValues")
}

model EmployeeSchedule {
  id             String    @id @default(uuid())
  employeeId     String
  workDate       DateTime  @db.Date
  startTime      DateTime  @db.Time
  endTime        DateTime  @db.Time
  checkInTime    DateTime?
  checkOutTime   DateTime?
  createdDate    DateTime  @default(now())
  modifiedDate   DateTime? @updatedAt
  createdBy      String?
  modifiedBy     String?
  statusId       Int       @default(0)
  propertiesJson Json?

  employee    Employee    @relation(fields: [employeeId], references: [id])
  statusValue StatusValue @relation(fields: [statusId], references: [id])

  @@index([employeeId])
  @@index([workDate])
  @@index([statusId])
  @@map("EmployeeSchedules")
}

model ReservationTable {
  id            String    @id @default(uuid())
  reservationId String
  tableId       String
  assignedAt    DateTime  @default(now())
  assignedBy    String?
  createdDate   DateTime  @default(now())
  modifiedDate  DateTime? @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  table       Table       @relation(fields: [tableId], references: [id])

  @@unique([reservationId, tableId])
  @@map("ReservationTables")
}

model Reservation {
  id                  String    @id @default(uuid())
  customerId          String
  numberOfGuests      Int
  time                DateTime
  specialRequests     String?
  depositAmount       Decimal   @db.Decimal(18, 2)
  checkedInAt         DateTime?
  createdDate         DateTime  @default(now())
  modifiedDate        DateTime? @updatedAt
  createdBy           String?
  modifiedBy          String?
  reservationStatusId Int       @default(0)
  confirmationCode    String?   @unique
  propertiesJson      Json?
  paymentDeadline     DateTime?

  customer    Customer           @relation(fields: [customerId], references: [id])
  statusValue StatusValue        @relation(fields: [reservationStatusId], references: [id])
  orders      Order[]
  payments    Payment[]
  tables      ReservationTable[]

  @@index([customerId])
  @@index([reservationStatusId])
  @@index([time])
  @@map("Reservations")
}

model Order {
  id             String    @id @default(uuid())
  reference      String    @unique
  customerId     String?
  reservationId  String?
  subTotal       Decimal   @db.Decimal(18, 2)
  discountAmount Decimal   @db.Decimal(18, 2)
  taxAmount      Decimal   @db.Decimal(18, 2)
  serviceCharge  Decimal   @db.Decimal(18, 2)
  totalAmount    Decimal   @db.Decimal(18, 2)
  completedAt    DateTime?
  cancelledAt    DateTime?
  handledBy      String?
  createdDate    DateTime  @default(now())
  modifiedDate   DateTime? @updatedAt
  createdBy      String?
  modifiedBy     String?
  orderStatusId  Int       @default(0)
  propertiesJson Json?

  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reservation        Reservation?        @relation(fields: [reservationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee           Employee?           @relation(fields: [handledBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orderDetails       OrderDetail[]
  payments           Payment[]
  pointsTransactions PointsTransaction[]
  promotionHistories PromotionHistory[]
  tableSessions      TableSession[]
  feedbacks          Feedback[]

  @@index([customerId])
  @@index([reservationId])
  @@index([orderStatusId])
  @@index([createdDate])
  @@index([handledBy])
  @@map("Orders")
}

model OrderDetail {
  id             String    @id @default(uuid())
  orderId        String
  dishId         String?
  quantity       Int
  note           String?
  createdDate    DateTime  @default(now())
  modifiedDate   DateTime? @updatedAt
  createdBy      String?
  modifiedBy     String?
  itemStatusId   Int       @default(0)
  propertiesJson Json?
  unitPrice      Decimal   @default(0.0) @db.Decimal(18, 2)
  comboPrice     Decimal?  @db.Decimal(18, 2)
  comboName      String?
  comboId        String?
  parentId       String?

  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish        Dish?         @relation(fields: [dishId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  combo       MealCombo?    @relation(fields: [comboId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  statusValue StatusValue   @relation(fields: [itemStatusId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent      OrderDetail?  @relation("OrderDetailHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    OrderDetail[] @relation("OrderDetailHierarchy")

  @@index([orderId])
  @@index([dishId])
  @@index([comboId])
  @@index([itemStatusId])
  @@map("OrderDetails")
}

model Payment {
  id              String    @id @default(uuid())
  orderId         String?
  reservationId   String?
  paymentMethodId String
  transactionId   String?
  amount          Decimal   @db.Decimal(18, 2)
  cashReceive     Decimal   @db.Decimal(18, 2)
  paymentDate     DateTime  @default(now())
  cashback        Decimal   @db.Decimal(18, 2)
  refundDate      DateTime?
  processedBy     String?
  createdDate     DateTime  @default(now())
  modifiedDate    DateTime? @updatedAt
  createdBy       String?
  modifiedBy      String?
  checkoutUrl     String?
  payOSOrderCode  BigInt?   @unique
  propertiesJson  Json?
  status          Int       @default(0)
  purpose         Int       @default(0)

  order       Order?       @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee    Employee?    @relation(fields: [processedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderId])
  @@index([reservationId])
  @@index([status])
  @@index([paymentDate])
  @@map("Payments")
}

model PointsTransaction {
  id             String    @id @default(uuid())
  customerId     String
  type           String // "EARN" | "REDEEM" | "BONUS" | "ADJUSTMENT" | "EXPIRE"
  points         Int
  orderId        String?
  sourceType     String? // "ORDER" | "REGISTRATION" | "MANUAL" | "SYSTEM"
  description    String?
  createdDate    DateTime  @default(now())
  modifiedDate   DateTime? @updatedAt
  createdBy      String?
  modifiedBy     String?
  propertiesJson Json?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("PointsTransactions")
}

model PromotionHistory {
  id             String    @id @default(uuid())
  promotionId    String
  orderId        String
  discountAmount Decimal   @db.Decimal(18, 2)
  createdDate    DateTime  @default(now())
  modifiedDate   DateTime? @updatedAt
  createdBy      String?
  modifiedBy     String?
  propertiesJson Json?

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id])

  @@map("PromotionHistories")
}

model TableSession {
  id             String    @id @default(uuid())
  tableId        String
  orderId        String?
  startedAt      DateTime
  endedAt        DateTime?
  isActive       Boolean
  createdDate    DateTime  @default(now())
  modifiedDate   DateTime? @updatedAt
  createdBy      String?
  modifiedBy     String?
  propertiesJson Json?

  table Table  @relation(fields: [tableId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order Order? @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tableId])
  @@index([isActive])
  @@index([startedAt])
  @@map("TableSessions")
}

model Feedback {
  id             String    @id @default(uuid())
  orderId        String
  customerId     String
  rating         Int
  comment        String?
  isPublished    Boolean
  isAnonymous    Boolean
  createdDate    DateTime  @default(now())
  modifiedDate   DateTime? @updatedAt
  createdBy      String?
  modifiedBy     String?
  propertiesJson Json?

  order    Order           @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer Customer        @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  images   FeedbackImage[]

  @@unique([orderId, customerId])
  @@map("Feedbacks")
}

model FeedbackImage {
  id             String    @id @default(uuid())
  feedbackId     String
  imageUrl       String
  displayOrder   Int
  isCover        Boolean
  createdDate    DateTime  @default(now())
  modifiedDate   DateTime? @updatedAt
  createdBy      String?
  modifiedBy     String?
  propertiesJson Json?

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@map("FeedbackImages")
}
