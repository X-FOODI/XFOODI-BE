{
  "name": "restx-api-documentation-generator",
  "version": "1.0.0",
  "packageManager": "pnpm@11.1.2",
  "description": "Documentation generator system that analyzes RestX Evolution architecture to extract patterns and generate comprehensive documentation",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "check": "pnpm lint && tsc --noEmit"
  },
  "keywords": [
    "documentation",
    "code-analysis",
    "architecture",
    "multi-service",
    "nodejs"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@sendgrid/mail": "^8.1.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/uuid": "^10.0.0",
    "awilix": "^10.0.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.3",
    "redis": "^5.12.1",
    "typescript": "^5.3.3",
    "uuid": "^14.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.1.1",
    "prisma": "^6.19.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2"
  }
}
