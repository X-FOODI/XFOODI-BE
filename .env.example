# Server Configuration
PORT=5000
NODE_ENV=development

# URLs Configuration
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:5000/api

# Database Connection
DATABASE_URL="postgresql://username:password@host:port/database?pgbouncer=true"
DIRECT_URL="postgresql://username:password@host:port/database"

# Redis Connection
REDIS_URL=redis://default:password@host:port

# Sendgrid Configuration
EMAIL_FROM=your_email@domain.com
EMAIL_REPLY_TO=your_email@domain.com
EMAIL_FROM_NAME="Your Support Name"

# JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key

# Google OAuth

# Turnstile Configuration
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Document Encryption
DOCUMENT_ENCRYPTION_KEY=your_document_encryption_key

# CopilotKit Configuration
COPILOTKIT_TELEMETRY_DISABLED=true

# Twilio SMS Configuration
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# AI Integration (Gemini & Cohere)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_EMBEDDING_API_KEY=your_gemini_embedding_api_key
COHERE_API_KEY=your_cohere_api_key