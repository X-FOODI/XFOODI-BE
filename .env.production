# Server Configuration
PORT=5000
NODE_ENV=production

# URLs Configuration
FRONTEND_URL=https://xfoodi.website
API_URL=https://api.xfoodi.website/api

# DATABASE CONNECTIOn
# Connect to Supabase via connection pooling
DATABASE_URL="your_production_database_url_here"

# Direct connection to the database. Used for migrations
DIRECT_URL="your_production_direct_url_here"

# REDIS
REDIS_URL="your_production_redis_url_here"

#SENDING MAIL BY SENDGRID
SENDGRID_API_KEY="your_production_sendgrid_api_key_here"
EMAIL_FROM=xfoodiprojects@gmail.com
EMAIL_REPLY_TO=xfoodiprojects@gmail.com
EMAIL_FROM_NAME=Xfoodi Support

# JWT SECRETS
JWT_ACCESS_SECRET="your_production_jwt_access_secret_here"
JWT_REFRESH_SECRET="your_production_jwt_refresh_secret_here"
